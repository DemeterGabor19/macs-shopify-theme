{{ 'macs-advice.css' | asset_url | stylesheet_tag }}

<section class="macs-advice-hero">
  <span class="macs-advice-hero__spot macs-advice-hero__spot--red" aria-hidden="true"></span>
  <span class="macs-advice-hero__spot macs-advice-hero__spot--yellow" aria-hidden="true"></span>

  <div class="macs-container macs-advice-hero__container">
    <div class="macs-advice-hero__content">
      {% if section.settings.eyebrow != blank %}
        <p class="macs-advice-hero__eyebrow">
          <span aria-hidden="true"></span>
          {{ section.settings.eyebrow | escape }}
        </p>
      {% endif %}

      {% if section.settings.title != blank or section.settings.highlighted_title != blank %}
        <h1 class="macs-advice-hero__title">
          {% if section.settings.title != blank %}
            <span>{{ section.settings.title | escape }}</span>
          {% endif %}

          {% if section.settings.highlighted_title != blank %}
            <em>{{ section.settings.highlighted_title | escape }}</em>
          {% endif %}
        </h1>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="macs-advice-hero__text rte">
          {{ section.settings.text }}
        </div>
      {% endif %}

      {% if section.settings.button_label != blank %}
        <a
          class="macs-advice-hero__button"
          href="{{ section.settings.button_link | default: '#taplalkozasi-tanacsadas-urlap' }}"
        >
          <span>{{ section.settings.button_label | escape }}</span>
          <span aria-hidden="true">↓</span>
        </a>
      {% endif %}

      {% if section.settings.helper_text != blank %}
        <p class="macs-advice-hero__helper">
          <span aria-hidden="true">✓</span>
          {{ section.settings.helper_text | escape }}
        </p>
      {% endif %}
    </div>

    <div class="macs-advice-hero__visual">
      <div class="macs-advice-hero__image-frame">
        {% if section.settings.image != blank %}
          {{
            section.settings.image
            | image_url: width: 1500
            | image_tag:
              class: 'macs-advice-hero__image',
              loading: 'eager',
              fetchpriority: 'high',
              widths: '480, 720, 960, 1200, 1500',
              sizes: '(max-width: 989px) 92vw, 46vw',
              alt: section.settings.image.alt
          }}
        {% else %}
          <div class="macs-advice-hero__placeholder">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>

      {% if section.settings.badge != blank %}
        <p class="macs-advice-hero__badge">
          {{ section.settings.badge | escape }}
        </p>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MAC’s – Tanácsadás hero",
  "tag": "section",
  "class": "macs-advice-hero-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Felső címke",
      "default": "Személyre szabott segítség"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Cím első része",
      "default": "Találjuk meg együtt"
    },
    {
      "type": "text",
      "id": "highlighted_title",
      "label": "Kiemelt címrész",
      "default": "a kutyádhoz illő eledelt!"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Bevezető szöveg",
      "default": "<p>Minden kutya más. Mesélj nekünk kedvencedről, jelenlegi táplálásáról és egyedi igényeiről, hogy személyre szabott segítséget adhassunk a megfelelő MAC’s termék kiválasztásához.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Gomb felirata",
      "default": "Kitöltöm a kérdőívet"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Gomb hivatkozása"
    },
    {
      "type": "text",
      "id": "helper_text",
      "label": "Gomb alatti szöveg",
      "default": "A kitöltés körülbelül 8–10 percet vesz igénybe."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero kép"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Kör alakú jelvény",
      "default": "Személyre szabott tanácsadás"
    }
  ],
  "presets": [
    {
      "name": "MAC’s – Tanácsadás hero"
    }
  ]
}
{% endschema %}
