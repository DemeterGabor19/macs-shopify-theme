{{ 'macs-b2b.css' | asset_url | stylesheet_tag }}

<section
  class="macs-b2b-contact"
  id="{{ section.settings.anchor_id | default: 'b2b-jelentkezes' | handleize }}"
>
  <div class="macs-container macs-b2b-contact__container">
    <div class="macs-b2b-contact__intro">
      {% if section.settings.eyebrow != blank %}
        <p class="macs-b2b-contact__eyebrow">
          <span aria-hidden="true"></span>
          {{ section.settings.eyebrow | escape }}
        </p>
      {% endif %}

      {% if section.settings.title != blank %}
        <h2 class="macs-b2b-contact__title">
          {{ section.settings.title | escape }}
        </h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="macs-b2b-contact__text rte">
          {{ section.settings.text }}
        </div>
      {% endif %}

      {% if section.settings.note != blank %}
        <div class="macs-b2b-contact__note">
          <span aria-hidden="true">↗</span>
          <p>{{ section.settings.note | escape }}</p>
        </div>
      {% endif %}
    </div>

    <div class="macs-b2b-contact__card">
      {% form 'contact', id: 'MacsB2BContactForm', class: 'macs-b2b-form' %}
        <input
          type="hidden"
          name="contact[Kapcsolatfelvétel típusa]"
          value="B2B viszonteladói jelentkezés"
        >

        {% if form.posted_successfully? %}
          <div class="macs-b2b-form__success" tabindex="-1" autofocus>
            <strong>{{ section.settings.success_title | escape }}</strong>
            <p>{{ section.settings.success_text | escape }}</p>
          </div>
        {% endif %}

        {% if form.errors %}
          <div class="macs-b2b-form__errors" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <div class="macs-b2b-form__grid">
          <label class="macs-b2b-field">
            <span>Kapcsolattartó neve *</span>
            <input
              type="text"
              name="contact[Kapcsolattartó neve]"
              value="{% if form.name %}{{ form.name | escape }}{% endif %}"
              autocomplete="name"
              required
            >
          </label>

          <label class="macs-b2b-field">
            <span>Cégnév / vállalkozás neve *</span>
            <input
              type="text"
              name="contact[Cégnév / vállalkozás neve]"
              autocomplete="organization"
              required
            >
          </label>

          <label class="macs-b2b-field">
            <span>E-mail cím *</span>
            <input
              type="email"
              name="contact[email]"
              value="{% if form.email %}{{ form.email | escape }}{% endif %}"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              required
            >
          </label>

          <label class="macs-b2b-field">
            <span>Telefonszám *</span>
            <input
              type="tel"
              name="contact[Telefonszám]"
              value="{% if form.phone %}{{ form.phone | escape }}{% endif %}"
              autocomplete="tel"
              required
            >
          </label>

          <label class="macs-b2b-field macs-b2b-field--full">
            <span>Weboldal / webshop URL</span>
            <input
              type="url"
              name="contact[Weboldal / webshop URL]"
              placeholder="https://"
              autocomplete="url"
            >
          </label>

          <label class="macs-b2b-field">
            <span>Vállalkozás típusa *</span>
            <select name="contact[Vállalkozás típusa]" required>
              <option value="" selected disabled>Válassz típust</option>
              <option value="Állateledelbolt">Állateledelbolt</option>
              <option value="Webshop">Webshop</option>
              <option value="Kutyaiskola">Kutyaiskola</option>
              <option value="Tenyésztő">Tenyésztő</option>
              <option value="Állatorvosi rendelő">Állatorvosi rendelő</option>
              <option value="Egyéb">Egyéb</option>
            </select>
          </label>

          <label class="macs-b2b-field">
            <span>Értékesítési forma *</span>
            <select name="contact[Értékesítési forma]" required>
              <option value="" selected disabled>Válassz formát</option>
              <option value="Fizikai üzlet">Fizikai üzlet</option>
              <option value="Webshop">Webshop</option>
              <option value="Mindkettő">Mindkettő</option>
            </select>
          </label>

          <label class="macs-b2b-field macs-b2b-field--full">
            <span>Település *</span>
            <input
              type="text"
              name="contact[Település]"
              autocomplete="address-level2"
              required
            >
          </label>

          <fieldset class="macs-b2b-form__choices macs-b2b-field--full">
            <legend>Mely termékek érdeklik?</legend>

            <div class="macs-b2b-form__choice-grid">
              <label>
                <input type="checkbox" name="contact[Érdeklődés – Szárazeledel]" value="Igen">
                <span>Szárazeledel</span>
              </label>

              <label>
                <input type="checkbox" name="contact[Érdeklődés – Nedveseledel]" value="Igen">
                <span>Nedveseledel</span>
              </label>

              <label>
                <input type="checkbox" name="contact[Érdeklődés – Monoprotein termékek]" value="Igen">
                <span>Monoprotein termékek</span>
              </label>

              <label>
                <input type="checkbox" name="contact[Érdeklődés – Jutalomfalatok]" value="Igen">
                <span>Jutalomfalatok</span>
              </label>

              <label>
                <input type="checkbox" name="contact[Érdeklődés – Kiegészítő eledelek]" value="Igen">
                <span>Kiegészítő eledelek</span>
              </label>

              <label>
                <input type="checkbox" name="contact[Érdeklődés – Italok]" value="Igen">
                <span>Italok</span>
              </label>

              <label>
                <input type="checkbox" name="contact[Érdeklődés – Teljes MAC’s kínálat]" value="Igen">
                <span>Teljes MAC’s kínálat</span>
              </label>
            </div>
          </fieldset>

          <label class="macs-b2b-field macs-b2b-field--full">
            <span>Megjegyzés / üzenet</span>
            <textarea name="contact[body]" rows="5">{% if form.body %}{{ form.body | escape }}{% endif %}</textarea>
          </label>

          <label class="macs-b2b-form__consent macs-b2b-field--full">
            <input
              type="checkbox"
              name="contact[Adatkezelési hozzájárulás]"
              value="Elfogadva"
              required
            >
            <span>
              Elolvastam és elfogadom az
              {% if section.settings.privacy_link != blank %}
                <a href="{{ section.settings.privacy_link }}">adatkezelési tájékoztatót</a>.
              {% else %}
                adatkezelési tájékoztatót.
              {% endif %}
              *
            </span>
          </label>
        </div>

        <button class="macs-b2b-form__submit" type="submit">
          <span>{{ section.settings.submit_label | escape }}</span>
          <span aria-hidden="true">→</span>
        </button>
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MAC’s – B2B űrlap",
  "tag": "section",
  "class": "macs-b2b-contact-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Horgonyazonosító",
      "default": "b2b-jelentkezes",
      "info": "A hero gombja erre a részre görget."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Felső címke",
      "default": "Első lépés"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Cím",
      "default": "Lépj velünk kapcsolatba!"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Leírás",
      "default": "<p>Szeretnéd üzletedben vagy webáruházadban is forgalmazni a MAC’s termékeket? Töltsd ki az űrlapot, és ismerd meg B2B kínálatunkat, partneri feltételeinket és a MAC’s termékpalettáját.</p>"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Kiemelt megjegyzés",
      "default": "A jelentkezés elküldése még nem jelent szerződéses kötelezettséget."
    },
    {
      "type": "url",
      "id": "privacy_link",
      "label": "Adatkezelési tájékoztató"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Küldés gomb felirata",
      "default": "Viszonteladói jelentkezés elküldése"
    },
    {
      "type": "text",
      "id": "success_title",
      "label": "Sikeres küldés címe",
      "default": "Köszönjük a jelentkezést!"
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Sikeres küldés szövege",
      "default": "Hamarosan felvesszük veled a kapcsolatot."
    }
  ],
  "presets": [
    {
      "name": "MAC’s – B2B űrlap"
    }
  ]
}
{% endschema %}
